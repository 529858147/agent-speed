<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AgentSpeed.ProfileHarness</AssemblyName>
    <RootNamespace>AgentSpeed.ProfileHarness</RootNamespace>
    <StartupObject>AgentSpeed.ProfileHarness.Program</StartupObject>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <IsTestProject>false</IsTestProject>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../tests/AgentSpeed.Windows.Tests/AgentSpeed.Windows.Tests.csproj" />
  </ItemGroup>
</Project>
