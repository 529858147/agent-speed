<UserControl x:Class="AgentSpeed.Reporting.ReportProfileCard" x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             xmlns:reporting="clr-namespace:AgentSpeed.Reporting"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <controls:TextToVisibilityConverter x:Key="HasText" />
        <Style x:Key="Note" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="17" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>
    <Border Padding="16,16,16,14" CornerRadius="6" Margin="0,0,0,4" BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid Width="72" Height="72" VerticalAlignment="Top" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                    <Grid.Clip><EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36" /></Grid.Clip>
                    <TextBlock Text="&#xE77B;" Style="{StaticResource SymbolIcon}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{Binding Avatar}" Stretch="UniformToFill" AutomationProperties.Name="{loc:Loc profile.title}" />
                </Grid>
                <StackPanel Grid.Column="2">
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="{Binding NameLabel}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox x:Name="ProfileNameBox" Text="{Binding DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="70" MaxLength="64" IsEnabled="{Binding CanEditName}" Margin="0,0,8,0"
                                 KeyDown="OnNameKeyDown" GotKeyboardFocus="OnNameGotFocus" LostKeyboardFocus="OnNameLostFocus"
                                 AutomationProperties.Name="{Binding NameLabel}" />
                        <Button x:Name="SaveNameButton" Grid.Column="1" Content="{loc:Loc profile.save}" Command="{Binding SaveNameCommand}" />
                    </Grid>
                    <TextBlock Text="{Binding IdentityText}" Style="{StaticResource Note}" Margin="0,6,0,0" />
                    <WrapPanel Margin="-4,6,0,0">
                        <Button x:Name="ChooseAvatarButton" Style="{StaticResource LinkButton}" Content="{Binding AvatarChoiceLabel}"
                                Command="{Binding ChooseAvatarCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding AvatarUnavailableHint}" />
                        <Button x:Name="RemoveAvatarButton" Style="{StaticResource LinkButton}" Content="{loc:Loc profile.avatar.remove}"
                                Command="{Binding RemoveAvatarCommand}" Margin="6,0,0,0" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
            <Border Margin="88,8,0,0" Visibility="{Binding HasPendingAvatar, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="{Binding AvatarStatus}" Style="{StaticResource Note}" AutomationProperties.LiveSetting="Polite" />
                    <WrapPanel Margin="0,6,0,0">
                        <Button x:Name="UploadAvatarButton" Content="{loc:Loc profile.avatar.save}" Command="{Binding UploadAvatarCommand}" Margin="0,0,8,6" />
                        <Button x:Name="CancelAvatarButton" Content="{loc:Loc history.cancel}" Command="{Binding CancelAvatarCommand}" Margin="0,0,0,6" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{loc:Loc profile.avatar.note}" Style="{StaticResource Note}" Margin="0,12,0,0" />
            <TextBlock Text="{Binding Status}" Style="{StaticResource Note}" Margin="0,8,0,0"
                       Visibility="{Binding Status, Converter={StaticResource HasText}}"
                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Polite" />
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,12,0,0" Padding="0,8,0,0">
                <WrapPanel Margin="-4,0,0,0">
                    <Button x:Name="ManageDevicesButton" Style="{StaticResource LinkButton}" Content="{loc:Loc profile.manageDevices}"
                            Command="{Binding ManageDevicesCommand, RelativeSource={RelativeSource AncestorType={x:Type reporting:ReportProfileCard}}}" />
                    <Button x:Name="RefreshProfileButton" Style="{StaticResource LinkButton}" Content="{loc:Loc profile.refresh}" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
