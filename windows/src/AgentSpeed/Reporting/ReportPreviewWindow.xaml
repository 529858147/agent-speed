<Window x:Class="AgentSpeed.Reporting.ReportPreviewWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AgentSpeed.Localization"
        Width="560" Height="640" MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        Title="{loc:Loc report.preview.title}"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.Name="{loc:Loc report.preview.title}">
    <Border Padding="20,16,20,16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE890;" FontSize="18" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Text="{loc:Loc report.preview.title}" Style="{StaticResource SubtitleText}" FontSize="18" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1" />
            <Border Grid.Column="2" Padding="10,3" CornerRadius="11" Background="{DynamicResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center"
                    x:Name="NextPill" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NextGlyph" Style="{StaticResource SymbolIcon}" Text="&#xE945;" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Visibility="Collapsed" />
                    <TextBlock x:Name="NextText" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Off" />
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="PreviewHost" Grid.Row="1" />
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="HintText" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Click="OnCopy" MinWidth="120" AutomationProperties.Name="{loc:Loc report.preview.copy}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE8C8;" FontSize="14" />
                    <TextBlock Text="{loc:Loc report.preview.copy}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
    </Border>
</Window>
