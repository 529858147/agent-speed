<UserControl x:Class="AgentSpeed.History.HistoryTooltip"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:history="clr-namespace:AgentSpeed.History"
             IsHitTestVisible="False"
             Focusable="False"
             Opacity="0"
             Visibility="Collapsed">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
    </UserControl.Resources>

    <!-- The margin leaves room for the shadow inside the overlay canvas. -->
    <Border Margin="10" MinWidth="236" MaxWidth="304" Padding="14,12,14,12" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource ToolTipBackgroundBrush}" BorderBrush="{DynamicResource ToolTipBorderBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Opacity="0.18" />
        </Border.Effect>
        <StackPanel TextElement.Foreground="{DynamicResource ToolTipForegroundBrush}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Margin="10,0,0,0" Padding="7,1,7,2" CornerRadius="9" VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        Visibility="{Binding HasBadge, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Badge}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
            </DockPanel>

            <ItemsControl ItemsSource="{Binding Lines}" Margin="0,8,0,0" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type history:TooltipLine}">
                        <Grid Margin="{Binding Margin}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center" Fill="{Binding Dot}"
                                     Visibility="{Binding HasDot, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                       Visibility="{Binding IsValue, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="12" Margin="16,0,0,0" FontWeight="{Binding Weight}"
                                       Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                                       Visibility="{Binding IsValue, Converter={StaticResource Visible}}" />
                            <TextBlock Grid.ColumnSpan="3" Text="{Binding Label}" FontSize="11" TextWrapping="Wrap"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Visibility="{Binding IsNote, Converter={StaticResource Visible}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                       Visibility="{Binding HasNote, Converter={StaticResource Visible}}" />

            <StackPanel Visibility="{Binding HasModels, Converter={StaticResource Visible}}">
                <Rectangle Height="1" Margin="0,10,0,8" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" SnapsToDevicePixels="True" />
                <TextBlock Text="{Binding ModelsTitle}" FontSize="11" Margin="0,0,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding Models}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type history:TooltipShare}">
                            <StackPanel Margin="0,3,0,3">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding Speed}" FontSize="12" Margin="12,0,0,0"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Visibility="{Binding HasSpeed, Converter={StaticResource Visible}}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Percent}" FontSize="12" Margin="12,0,0,0"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Grid.Column="3" Text="{Binding Cost}" FontSize="12" Margin="10,0,0,0"
                                               Typography.NumeralAlignment="Tabular"
                                               Visibility="{Binding HasCost, Converter={StaticResource Visible}}" />
                                </Grid>
                                <history:ShareBar Height="4" Margin="0,4,0,0" Value="{Binding Share}"
                                                  Fill="{DynamicResource AccentFillColorDefaultBrush}"
                                                  Track="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
