<UserControl x:Class="AgentSpeed.History.UnpricedPanel"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:history="clr-namespace:AgentSpeed.History"
             xmlns:layout="clr-namespace:AgentSpeed.Presentation.History;assembly=AgentSpeed.Presentation">
    <!-- The unknown-prices popover's content (DESIGN 9, Unknown prices): header, source groups that scroll, priced-now
         note, and the copy footer. 348 DIP of content inside the flyout's 16 DIP padding make the 380 DIP card. -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- The reason chip: the label colour at 9 % fill and a 0.5 DIP stroke at 16 %, the same neutral look for every
             reason (an unknown price is a gap, not an error). -->
        <Style x:Key="ReasonChip" TargetType="Grid">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="RowList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One row is one element for screen readers: the model, then reason, provider, Fast, lookup key, requests and days
             seen; the help is the reason's hint. Hover and focus show a soft chip; nothing looks selected. -->
        <Style x:Key="RowItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="6,3,6,3" />
            <Setter Property="Margin" Value="0,0,0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Model}" />
            <Setter Property="AutomationProperties.ItemStatus" Value="{Binding AccessibleValue}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding ReasonHint}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="5" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate" DataType="{x:Type layout:UnpricedRowView}">
            <StackPanel Background="Transparent">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Requests}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <history:MiddleTrimmedText x:Name="Model" Text="{Binding Model}" FontSize="12.5" FontWeight="Medium" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" ToolTip="{Binding Model}" />
                </DockPanel>
                <DockPanel Margin="0,3,0,0" ToolTip="{Binding Tooltip}">
                    <Grid DockPanel.Dock="Left" Style="{StaticResource ReasonChip}" ToolTip="{Binding ReasonHint}"
                          ToolTipService.InitialShowDelay="300">
                        <Border CornerRadius="7" Background="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.09" />
                        <Border CornerRadius="7" BorderBrush="{DynamicResource TextFillColorSecondaryBrush}" BorderThickness="0.5" Opacity="0.16" />
                        <TextBlock Text="{Binding Reason}" FontSize="10.5" FontWeight="Medium" Margin="5,1,5,1"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Grid>
                    <TextBlock history:UnpricedDetailText.Row="{Binding}" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </DockPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsUnnamed}" Value="True">
                    <Setter TargetName="Model" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Model" Property="FontWeight" Value="Normal" />
                    <Setter TargetName="Model" Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- The copy button's three faces share one cell, so the button keeps the widest one's width and nothing shifts. -->
        <Style x:Key="CopyFace" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid MaxHeight="440">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding UnpricedCount}" FontSize="13" Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
            <TextBlock Text="{loc:Loc cost.unknown}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level2" />
        </DockPanel>

        <ScrollViewer x:Name="Scroller" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly">
            <StackPanel>
                <ItemsControl x:Name="Groups" ItemsSource="{Binding UnpricedGroups}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type history:UnpricedGroupItem}">
                            <StackPanel Margin="{Binding Margin}">
                                <DockPanel Margin="0,0,0,5">
                                    <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,1,7,0" VerticalAlignment="Center" Fill="{Binding Dot}" />
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding View.Requests}" FontSize="12" VerticalAlignment="Center"
                                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding View.Name}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" AutomationProperties.Name="{Binding View.AccessibleName}"
                                               AutomationProperties.HeadingLevel="Level3" />
                                </DockPanel>
                                <ListBox ItemsSource="{Binding View.Rows}" Style="{StaticResource RowList}" ItemContainerStyle="{StaticResource RowItem}"
                                         ItemTemplate="{StaticResource RowTemplate}" Margin="8,0,-6,0"
                                         AutomationProperties.Name="{Binding View.AccessibleName}" />
                                <TextBlock Text="{Binding View.More}" FontSize="11" Margin="14,5,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Visibility="{Binding HasMore, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding UnpricedPricedNow}" FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Visibility="{Binding HasUnpricedPricedNow, Converter={StaticResource Visible}}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <Rectangle Style="{StaticResource Hairline}" Margin="0,12,0,10" />
            <TextBlock Text="{loc:Loc history.unpricedModels.hint}" FontSize="11.5" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <DockPanel Margin="0,10,0,0">
                <Button x:Name="CopyButton" DockPanel.Dock="Left" Height="28" MinHeight="28" Padding="10,0" FontSize="12" VerticalAlignment="Top"
                        Click="OnCopy" AutomationProperties.Name="{loc:Loc history.unpricedModels.copy}"
                        AutomationProperties.HelpText="{loc:Loc history.unpricedModels.copyHint}">
                    <Grid>
                        <StackPanel x:Name="IdleFace" Style="{StaticResource CopyFace}">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE8C8;" FontSize="12" Margin="0,1,6,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <TextBlock Text="{loc:Loc history.unpricedModels.copy}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="CopiedFace" Style="{StaticResource CopyFace}" Opacity="0" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE73E;" FontSize="12" Margin="0,1,6,0"
                                       Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Text="{loc:Loc history.unpricedModels.copied}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel x:Name="FailedFace" Style="{StaticResource CopyFace}" Opacity="0" IsHitTestVisible="False">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE7BA;" FontSize="12" Margin="0,1,6,0"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{loc:Loc history.unpricedModels.copyFailed}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>
                <TextBlock Text="{loc:Loc history.unpricedModels.copyHint}" FontSize="11" TextWrapping="Wrap" Margin="10,0,0,0"
                           VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </DockPanel>
        </StackPanel>
    </Grid>
</UserControl>
