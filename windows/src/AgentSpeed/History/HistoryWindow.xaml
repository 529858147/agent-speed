<Window x:Class="AgentSpeed.History.HistoryWindow"
        x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AgentSpeed.Localization"
        xmlns:controls="clr-namespace:AgentSpeed.Controls"
        xmlns:history="clr-namespace:AgentSpeed.History"
        xmlns:layout="clr-namespace:AgentSpeed.Presentation.History;assembly=AgentSpeed.Presentation"
        Title="{loc:Loc history.title}"
        Width="920" Height="680" MinWidth="720" MinHeight="540"
        WindowStartupLocation="Manual"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource AppFontFamily}"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
        AutomationProperties.Name="{loc:Loc history.title}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <controls:InverseBoolToVisibilityConverter x:Key="Hidden" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <!-- The custom range item: looks like a segmented item, but opens the flyout instead of selecting. -->
        <Style x:Key="SegmentedToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Chip" CornerRadius="4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sortable table header: secondary text, primary when sorted; numbers right-aligned like their column. -->
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Chip" CornerRadius="4" Background="{TemplateBinding Background}" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="False" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A subscription source carries the cost.subscription.tag pill (DESIGN 9); the name trims before the pill does. -->
        <DataTemplate x:Key="SourceOptionTemplate" DataType="{x:Type history:SourceOption}">
            <DockPanel LastChildFill="True" AutomationProperties.Name="{Binding AccessibleName}">
                <history:SourceDot DockPanel.Dock="Left" Width="10" Height="10" VerticalAlignment="Center" Colors="{Binding Colors}" />
                <Border DockPanel.Dock="Right" Margin="8,0,0,0" Padding="6,0,6,1" CornerRadius="8" VerticalAlignment="Center"
                        Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                        Visibility="{Binding HasTag, Converter={StaticResource Visible}}">
                    <TextBlock Text="{Binding Tag}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Border>
                <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- The compact include-subscriptions toggle: an icon chip, raised while on; the label is its tooltip and name. -->
        <Style x:Key="IconToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="Chip" CornerRadius="4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Three or five cards in a row: the sparkline spans the card under the value; two in a row: it sits beside the value. -->
        <DataTemplate x:Key="SummaryCardTemplate" DataType="{x:Type history:SummaryCardView}">
            <Border Style="{StaticResource Card}" Margin="6" Padding="16,13,16,14"
                    AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="{Binding HelpText}">
                <Border.ToolTip>
                    <ToolTip>
                        <TextBlock Text="{Binding Tooltip}" TextWrapping="Wrap" MaxWidth="360" Typography.NumeralAlignment="Tabular" />
                    </ToolTip>
                </Border.ToolTip>
                <Grid VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.ColumnSpan="2" Text="{Binding Label}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <!-- A long amount shrinks to the card instead of being clipped; the line keeps its height, so cards stay aligned. -->
                    <Grid Grid.Row="1" Margin="0,4,0,0" Height="32">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Value}" FontSize="26" FontWeight="SemiBold" FontFamily="{DynamicResource AppDisplayFontFamily}"
                                           Typography.NumeralAlignment="Tabular" LineHeight="32" LineStackingStrategy="BlockLineHeight" />
                                <TextBlock Text="{Binding Unit}" FontSize="12" Margin="5,0,0,5" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasUnit, Converter={StaticResource Visible}}" />
                            </StackPanel>
                        </Viewbox>
                    </Grid>
                    <history:Sparkline Values="{Binding Spark}" Highlight="{Binding SparkHighlight}">
                        <history:Sparkline.Style>
                            <Style TargetType="history:Sparkline">
                                <Setter Property="Stroke" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Setter Property="Grid.Row" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="Height" Value="24" />
                                <Setter Property="Margin" Value="0,10,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSparkBrush}" Value="True">
                                        <Setter Property="Stroke" Value="{Binding SparkBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SideBySide}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.Column" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="1" />
                                        <Setter Property="Width" Value="76" />
                                        <Setter Property="Height" Value="28" />
                                        <Setter Property="Margin" Value="10,0,0,3" />
                                        <Setter Property="VerticalAlignment" Value="Bottom" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </history:Sparkline.Style>
                    </history:Sparkline>
                    <!-- Up to two lines, so a narrow card keeps the whole comparison. -->
                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               LineHeight="16" LineStackingStrategy="BlockLineHeight" MinHeight="16" MaxHeight="32"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                        <Run Text="{Binding SecondaryLead, Mode=OneWay}" /><Run Text="{Binding SecondaryChange, Mode=OneWay}" FontWeight="SemiBold">
                            <Run.Style>
                                <Style TargetType="Run">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUp}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDown}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Run.Style>
                        </Run><Run Text="{Binding SecondaryTail, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Border>
        </DataTemplate>
        <!-- Single-day breakdown: a plain keyboard list (no scroller of its own, so the page scrolls over it) -->
        <Style x:Key="BreakdownListStyle" TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ItemsPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type history:BreakdownRowView}">
                        <Grid Height="34" Background="Transparent" ToolTip="{Binding ToolTip}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{x:Static history:BreakdownColumns.Name}" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="{x:Static history:BreakdownColumns.Output}" />
                                <ColumnDefinition Width="{x:Static history:BreakdownColumns.Cost}" />
                                <ColumnDefinition Width="{x:Static history:BreakdownColumns.Share}" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <DockPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{Binding DotBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" FontSize="13" Margin="10,0,0,0" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <history:BreakdownBar Grid.Column="1" Height="10" VerticalAlignment="Center" Value="{Binding Fraction}"
                                                  Color="{Binding BarColor}" Hatched="{Binding Hatched}"
                                                  Track="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding OutputText}" FontSize="13" FontWeight="SemiBold" TextAlignment="Right"
                                       VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                            <!-- ≥ small and secondary in front of the amount; – and the subscription tag stay quiet (DESIGN 9). -->
                            <TextBlock Grid.Column="3" TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Typography.NumeralAlignment="Tabular" Background="Transparent" ToolTip="{Binding CostToolTip}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="13" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CostQuiet}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <Setter Property="FontSize" Value="12" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="{Binding CostPrefix, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                                    Text="{Binding CostText, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Grid.Column="4" Text="{Binding ShareText}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="5" Text="{Binding SpeedText}" FontSize="12" TextAlignment="Right" VerticalAlignment="Center"
                                       Width="{x:Static history:BreakdownColumns.SpeedWidth}" TextTrimming="CharacterEllipsis"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The unknown-price models: a keyboard list that scrolls inside the flyout, rows without a selection chip -->
        <Style x:Key="UnpricedListStyle" TargetType="ListBox">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="KeyboardNavigation.TabNavigation" Value="Once" />
            <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Contained" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="False" PanningMode="VerticalOnly">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type history:UnpricedModelView}">
                        <DockPanel Height="26" Background="Transparent" ToolTip="{Binding SourceName}">
                            <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding Dot}" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Requests}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UnpricedItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BreakdownItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource RoundedFocusVisual}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <Setter Property="AutomationProperties.HelpText" Value="{Binding HelpText}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chip" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSource}" Value="True">
                                <Setter Property="Cursor" Value="Hand" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title and the resolved range -->
        <StackPanel Grid.Row="0" Margin="24,16,24,0">
            <TextBlock Text="{loc:Loc history.title}" Style="{StaticResource SubtitleText}" AutomationProperties.HeadingLevel="Level1" />
            <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,3,0,0" Typography.NumeralAlignment="Tabular"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!-- Toolbar: source, range, export -->
        <Grid x:Name="Toolbar" Grid.Row="1" Margin="24,16,24,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="SourceGroup" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox x:Name="SourcePicker" MinWidth="{x:Static layout:HistoryToolbar.PickerMinWidth}"
                          MaxWidth="{x:Static layout:HistoryToolbar.PickerMaxWidth}" VerticalAlignment="Center"
                          ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                          ItemTemplate="{StaticResource SourceOptionTemplate}" AutomationProperties.Name="{loc:Loc dashboard.sources}" />
                <!-- Shown while a source is marked as a subscription (DESIGN 9); an icon toggle once the toolbar narrows. -->
                <Grid x:Name="SubscriptionsGroup" Margin="{x:Static history:HistoryWindow.SubscriptionsMargin}" VerticalAlignment="Center"
                      Visibility="{Binding OffersSubscriptions, Converter={StaticResource Visible}}">
                    <CheckBox x:Name="SubscriptionsCheck" MinWidth="0" VerticalAlignment="Center" IsChecked="{Binding IncludeSubscriptions, Mode=TwoWay}"
                              AutomationProperties.Name="{loc:Loc history.includeSubscriptions}"
                              AutomationProperties.HelpText="{loc:Loc cost.apiEquivalent.hint}">
                        <CheckBox.ToolTip>
                            <ToolTip>
                                <TextBlock Text="{loc:Loc cost.apiEquivalent.hint}" TextWrapping="Wrap" MaxWidth="360" />
                            </ToolTip>
                        </CheckBox.ToolTip>
                        <TextBlock x:Name="SubscriptionsLabel" Text="{loc:Loc history.includeSubscriptions}" FontSize="13" Margin="2,0,0,0"
                                   VerticalAlignment="Center" />
                    </CheckBox>
                    <ToggleButton x:Name="SubscriptionsToggle" Style="{StaticResource IconToggle}" Visibility="Collapsed"
                                  IsChecked="{Binding IncludeSubscriptions, Mode=TwoWay}"
                                  AutomationProperties.Name="{loc:Loc history.includeSubscriptions}"
                                  AutomationProperties.HelpText="{loc:Loc cost.apiEquivalent.hint}">
                        <ToggleButton.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="360">
                                    <TextBlock Text="{loc:Loc history.includeSubscriptions}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{loc:Loc cost.apiEquivalent.hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </ToolTip>
                        </ToggleButton.ToolTip>
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE8C7;" FontSize="16" />
                    </ToggleButton>
                </Grid>
            </StackPanel>

            <Border x:Name="RangeGroup" Grid.Column="1" Style="{StaticResource SegmentedContainer}" HorizontalAlignment="Center"
                    VerticalAlignment="Center" Margin="12,0" AutomationProperties.Name="{loc:Loc win.history.range}"
                    KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                <StackPanel x:Name="RangeItems" Orientation="Horizontal">
                    <RadioButton x:Name="RangeToday" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="Today"
                                 Content="{loc:Loc history.range.today}" Checked="OnRangeChecked" />
                    <RadioButton x:Name="RangeYesterday" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="Yesterday"
                                 Content="{loc:Loc history.range.yesterday}" Checked="OnRangeChecked" />
                    <RadioButton x:Name="Range7" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="Days7"
                                 Content="{loc:Loc history.range.7d}" Checked="OnRangeChecked" />
                    <RadioButton x:Name="Range30" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="Days30"
                                 Content="{loc:Loc history.range.30d}" Checked="OnRangeChecked" />
                    <RadioButton x:Name="Range90" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="Days90"
                                 Content="{loc:Loc history.range.90d}" Checked="OnRangeChecked" />
                    <RadioButton x:Name="RangeYear" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="Year"
                                 Content="{loc:Loc history.range.year}" Checked="OnRangeChecked" />
                    <RadioButton x:Name="RangeAll" Style="{StaticResource SegmentedItem}" GroupName="HistoryRange" Tag="All"
                                 Content="{loc:Loc history.range.all}" Checked="OnRangeChecked" />
                    <ToggleButton x:Name="CustomToggle" Style="{StaticResource SegmentedToggle}" Click="OnCustomClick"
                                  Content="{loc:Loc history.range.custom}" AutomationProperties.Name="{loc:Loc history.range.custom}" />
                </StackPanel>
            </Border>

            <Button x:Name="ExportButton" Grid.Column="2" VerticalAlignment="Center" Click="OnExport" Padding="11,5,12,6"
                    ToolTip="{loc:Loc history.export}" AutomationProperties.Name="{loc:Loc history.export}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEDE1;" FontSize="14" />
                    <TextBlock x:Name="ExportLabel" Text="{loc:Loc history.export}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>

            <Popup x:Name="CustomFlyout" PlacementTarget="{Binding ElementName=CustomToggle}" Placement="Custom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade" Closed="OnCustomClosed" KeyDown="OnFlyoutKeyDown">
                <Border Margin="12" Padding="16,14,16,16" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                        TextElement.FontFamily="{DynamicResource AppFontFamily}"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{loc:Loc history.range.from}" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <DatePicker x:Name="FromPicker" Grid.Column="2" SelectedDateFormat="Short" SelectedDateChanged="OnFromChanged"
                                    AutomationProperties.Name="{loc:Loc history.range.from}" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc history.range.to}" VerticalAlignment="Center" FontSize="13"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <DatePicker x:Name="ToPicker" Grid.Row="2" Grid.Column="2" SelectedDateFormat="Short" SelectedDateChanged="OnToChanged"
                                    AutomationProperties.Name="{loc:Loc history.range.to}" />
                        <Button x:Name="ApplyCustomButton" Grid.Row="4" Grid.ColumnSpan="3" HorizontalAlignment="Right" MinWidth="96"
                                Style="{DynamicResource AccentButtonStyle}" Content="{loc:Loc history.range.apply}" Click="OnApplyCustom" />
                    </Grid>
                </Border>
            </Popup>
        </Grid>

        <!-- Content -->
        <ScrollViewer x:Name="PageScroller" Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      PanningMode="VerticalOnly" Focusable="False">
            <Grid x:Name="PageContent" Margin="24,6,24,24">
                <StackPanel x:Name="Body" Visibility="{Binding IsEmpty, Converter={StaticResource Hidden}}">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource SummaryCardTemplate}" Margin="-6"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <history:SummaryCardsPanel Rows="{Binding CardRows, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <!-- Chart: daily bars, or one day's breakdown -->
                    <Border x:Name="ChartCard" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="16,14,16,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- 每日輸出 | 費用 | 網路流量 (DESIGN 9, 10): what the bars, or one day's breakdown, measure. -->
                                    <Border x:Name="MetricGroup" Style="{StaticResource SegmentedContainer}" VerticalAlignment="Center"
                                            KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="MetricOutput" Style="{StaticResource SegmentedItem}" GroupName="HistoryMetric"
                                                         Tag="Output" Content="{loc:Loc history.chart.output}" Checked="OnMetricChecked" />
                                            <RadioButton x:Name="MetricCost" Style="{StaticResource SegmentedItem}" GroupName="HistoryMetric"
                                                         Tag="Cost" Content="{loc:Loc history.chart.cost}" Checked="OnMetricChecked"
                                                         AutomationProperties.HelpText="{loc:Loc cost.apiEquivalent}">
                                                <RadioButton.ToolTip>
                                                    <ToolTip>
                                                        <StackPanel MaxWidth="360">
                                                            <TextBlock Text="{loc:Loc cost.apiEquivalent}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{loc:Loc cost.apiEquivalent.hint}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </ToolTip>
                                                </RadioButton.ToolTip>
                                            </RadioButton>
                                            <RadioButton x:Name="MetricTraffic" Style="{StaticResource SegmentedItem}" GroupName="HistoryMetric"
                                                         Tag="Traffic" Content="{loc:Loc history.chart.traffic}" Checked="OnMetricChecked" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding BreakdownTitle}" Style="{StaticResource BodyStrongText}" FontSize="13" Margin="12,0,0,0"
                                               VerticalAlignment="Center" AutomationProperties.HeadingLevel="Level2"
                                               Visibility="{Binding IsSingleDay, Converter={StaticResource Visible}}" />
                                    <Border Margin="10,0,0,0" Padding="7,1,7,2" CornerRadius="9" VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            Visibility="{Binding IsInProgress, Converter={StaticResource Visible}}">
                                        <TextBlock Text="{loc:Loc history.inProgress}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Border>
                                </StackPanel>
                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Legend}" Margin="14,0,8,0" Focusable="False" VerticalAlignment="Center"
                                              Visibility="{Binding IsSingleDay, Converter={StaticResource Hidden}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type history:LegendItem}">
                                            <StackPanel Orientation="Horizontal" Margin="0,2,14,2">
                                                <Rectangle Width="9" Height="9" RadiusX="2" RadiusY="2" Fill="{Binding Brush}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                            Visibility="{Binding ShowsSpeedKey, Converter={StaticResource Visible}}">
                                    <Grid Width="18" Height="10" VerticalAlignment="Center">
                                        <Rectangle Height="1.5" VerticalAlignment="Center" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85" />
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource TextFillColorPrimaryBrush}" Opacity="0.85" />
                                    </Grid>
                                    <TextBlock FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                        <Run Text="{loc:Loc history.chart.speed}" /><Run Text=" · " /><Run Text="{loc:Loc unit.tokS}" />
                                    </TextBlock>
                                </StackPanel>
                                <!-- The traffic metric's range total (DESIGN 10): ↓ 4.20 GB · ↑ 312 MB -->
                                <TextBlock Grid.Column="2" Text="{Binding TrafficTotal}" FontSize="12" VerticalAlignment="Center"
                                           Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           AutomationProperties.Name="{Binding TrafficTotal}"
                                           Visibility="{Binding HasTrafficTotal, Converter={StaticResource Visible}}" />
                            </Grid>
                            <history:HistoryChart x:Name="Chart" Grid.Row="1" Height="260" Margin="0,10,0,0"
                                                  Visibility="{Binding IsSingleDay, Converter={StaticResource Hidden}}"
                                                  LabelBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                  MutedBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                  GridBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                                  LineBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                  HighlightBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                  FocusBrush="{DynamicResource KeyboardFocusBorderColorBrush}"
                                                  AutomationProperties.Name="{Binding ChartName}" />

                            <!-- One day: a bar per source (all sources) or per model (one source), largest first -->
                            <Grid x:Name="BreakdownPanel" Grid.Row="1" Margin="0,12,0,6"
                                  Visibility="{Binding IsSingleDay, Converter={StaticResource Visible}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,4" TextElement.FontSize="11" TextElement.Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{x:Static history:BreakdownColumns.Name}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{x:Static history:BreakdownColumns.Output}" />
                                        <ColumnDefinition Width="{x:Static history:BreakdownColumns.Cost}" />
                                        <ColumnDefinition Width="{x:Static history:BreakdownColumns.Share}" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="2" Text="{loc:Loc history.table.output}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{loc:Loc history.table.cost}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{loc:Loc win.history.share}" TextAlignment="Right" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="5" Text="{loc:Loc history.table.speed}" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                               Width="{x:Static history:BreakdownColumns.SpeedWidth}" />
                                </Grid>
                                <ListBox x:Name="BreakdownList" Grid.Row="1" Margin="-8,0" ItemsSource="{Binding Breakdown}"
                                         Style="{StaticResource BreakdownListStyle}" ItemContainerStyle="{StaticResource BreakdownItemStyle}"
                                         AutomationProperties.Name="{Binding ChartTitle}"
                                         Visibility="{Binding HasBreakdown, Converter={StaticResource Visible}}" />
                                <TextBlock Grid.Row="1" Text="{loc:Loc history.empty}" FontSize="13" HorizontalAlignment="Center" Margin="0,22,0,22"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Visibility="{Binding HasBreakdown, Converter={StaticResource Hidden}}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Daily table -->
                    <Border x:Name="TableCard" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="0,6,0,8">
                        <StackPanel>
                            <history:TableHeaderPanel x:Name="TableHeader" Height="30" Margin="0,0,0,2" />
                            <Rectangle Style="{StaticResource Hairline}" Margin="12,2,12,4" />
                            <history:DailyTable x:Name="Table"
                                                TextBrush="{DynamicResource TextFillColorPrimaryBrush}"
                                                SecondaryBrush="{DynamicResource TextFillColorSecondaryBrush}"
                                                MutedBrush="{DynamicResource TextFillColorTertiaryBrush}"
                                                AltRowBrush="{DynamicResource SubtleFillColorTertiaryBrush}"
                                                HoverBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                SelectedBrush="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                FocusBrush="{DynamicResource KeyboardFocusBorderColorBrush}"
                                                AccentBrush="{DynamicResource AccentFillColorDefaultBrush}"
                                                AutomationProperties.Name="{loc:Loc win.history.table}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,72,0,72"
                            Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                    <controls:GaugeGlyph Width="44" Height="44" HorizontalAlignment="Center" Opacity="0.8"
                                         TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="{loc:Loc history.empty}" Style="{StaticResource BodyStrongText}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="{loc:Loc history.empty.hint}" Style="{StaticResource CaptionText}" HorizontalAlignment="Center"
                               TextAlignment="Center" Margin="0,6,0,0" MaxWidth="360" />
                </StackPanel>

                <!-- Hover card layer, above every card -->
                <Canvas x:Name="Overlay" IsHitTestVisible="False" Panel.ZIndex="10" ClipToBounds="False">
                    <history:HistoryTooltip x:Name="HoverCard" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <!-- Appears once the page scrolls under the toolbar -->
        <Rectangle x:Name="ScrollDivider" Grid.Row="2" Style="{StaticResource Hairline}" VerticalAlignment="Top" Margin="0,14,0,0"
                   Opacity="0" IsHitTestVisible="False" />

        <!-- Footer: analysis state and the unknown-price notice on the left; the rate note and privacy on the right -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" Padding="24,9,24,10">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding HasMessage, Converter={StaticResource Hidden}}">
                    <TextBlock Text="{Binding StateText}" FontSize="12" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                    <ProgressBar Width="120" Height="3" MinHeight="3" Margin="10,1,0,0" Minimum="0" Maximum="1" VerticalAlignment="Center"
                                 Value="{Binding Progress, Mode=OneWay}" AutomationProperties.Name="{Binding StateText}"
                                 Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding FilesText}" FontSize="12" Margin="10,0,0,0" Typography.NumeralAlignment="Tabular"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               Visibility="{Binding IsAnalyzing, Converter={StaticResource Visible}}" />
                    <Button Style="{StaticResource LinkButton}" Height="22" Margin="6,0,0,0" FontSize="12" Command="{Binding RetryCommand}"
                            Content="{loc:Loc update.retry}" Visibility="{Binding IsFailed, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0"
                            Visibility="{Binding HasMessage, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE783;" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                    <TextBlock Text="{Binding Message}" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}" AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <!-- 網路流量自 10/22 開始記錄 (DESIGN 10): the range starts before traffic was measured. -->
                <DockPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding HasTrafficSince, Converter={StaticResource Visible}}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SymbolIcon}" Text="&#xE839;" FontSize="12" Margin="0,1,6,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <TextBlock Text="{Binding TrafficSinceText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               MaxWidth="260" Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding TrafficSinceText}" />
                </DockPanel>

                <!-- 1,234 筆請求的模型價格未知，未計入費用 · 查看 (DESIGN 9): the text trims before the link does. -->
                <DockPanel x:Name="UnpricedNotice" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,16,0"
                           Visibility="{Binding HasUnpriced, Converter={StaticResource Visible}}">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SymbolIcon}" Text="&#xE946;" FontSize="12" Margin="0,1,6,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Button x:Name="UnpricedButton" DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Height="22" Margin="2,0,0,0"
                            FontSize="12" Content="{loc:Loc history.unpricedNotice.show}" Click="OnShowUnpriced"
                            AutomationProperties.Name="{loc:Loc history.unpricedNotice.show}"
                            AutomationProperties.HelpText="{Binding UnpricedText}" />
                    <TextBlock Text="{Binding UnpricedText}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="300"
                               Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               ToolTip="{Binding UnpricedText}" />
                </DockPanel>

                <!-- The rate note keeps its room before the privacy line does; both trim rather than clip. -->
                <DockPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <DockPanel DockPanel.Dock="Left" VerticalAlignment="Center" Visibility="{Binding HasRateNote, Converter={StaticResource Visible}}">
                        <Ellipse DockPanel.Dock="Right" Width="3" Height="3" Margin="8,1,8,0" VerticalAlignment="Center"
                                 Fill="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{Binding RateNote}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Typography.NumeralAlignment="Tabular" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   ToolTip="{Binding RateNote}" />
                    </DockPanel>
                    <DockPanel ToolTip="{loc:Loc history.privacy}">
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource SymbolIcon}" Text="&#xE72E;" FontSize="11" Margin="0,1,6,0"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Text="{loc:Loc history.privacy}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </DockPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- The models behind the unknown-price notice: name, requests and source; closes with Escape or a click elsewhere. -->
        <!-- Offsets take back the card's 12 DIP shadow margin: the card starts at the notice's icon, 4 DIP above it. -->
        <Popup x:Name="UnpricedFlyout" Grid.Row="3" PlacementTarget="{Binding ElementName=UnpricedNotice}" Placement="Top" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-12" VerticalOffset="8" Closed="OnUnpricedClosed"
               KeyDown="OnUnpricedKeyDown">
            <Border Margin="12" Width="300" Padding="16,14,16,14" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    TextElement.FontFamily="{DynamicResource AppFontFamily}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{loc:Loc cost.unknown}" FontSize="13" FontWeight="SemiBold" AutomationProperties.HeadingLevel="Level2" />
                    <ListBox x:Name="UnpricedList" Margin="-8,8,-8,0" MaxHeight="220" ItemsSource="{Binding UnpricedModels}"
                             Style="{StaticResource UnpricedListStyle}" ItemContainerStyle="{StaticResource UnpricedItemStyle}"
                             AutomationProperties.Name="{loc:Loc cost.unknown}" />
                    <Rectangle Style="{StaticResource Hairline}" Margin="0,10,0,8" />
                    <TextBlock Text="{loc:Loc history.unpricedModels.hint}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
