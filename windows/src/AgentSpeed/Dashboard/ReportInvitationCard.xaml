<UserControl x:Class="AgentSpeed.Dashboard.ReportInvitationCard"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:controls="clr-namespace:AgentSpeed.Controls"
             Focusable="False">

    <Border x:Name="Shell" CornerRadius="12" BorderThickness="0.5" Margin="0,0,0,14" ClipToBounds="False" RenderTransformOrigin="0.5,0"
            AutomationProperties.Name="{loc:Loc report.invite.title}">
        <Border.RenderTransform>
            <TranslateTransform x:Name="Slide" />
        </Border.RenderTransform>
        <Grid>
            <!-- The offer -->
            <StackPanel x:Name="Offer" Margin="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <controls:AccentBadge Width="22" Height="22" CornerRadius="6" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xEC05;" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                    </controls:AccentBadge>
                    <TextBlock x:Name="Heading" Grid.Column="1" Text="{loc:Loc report.invite.title}" FontSize="13" FontWeight="SemiBold" Margin="8,0,8,0"
                               VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Focusable="False" KeyboardNavigation.TabIndex="0" AutomationProperties.HeadingLevel="Level2" />
                    <Button x:Name="CloseButton" Grid.Column="2" Width="18" Height="18" MinWidth="18" Padding="0" VerticalAlignment="Top" Margin="0,-2,-4,0"
                            Style="{StaticResource SubtleButton}" Click="OnDecline" KeyboardNavigation.TabIndex="6"
                            ToolTip="{loc:Loc report.invite.decline}" AutomationProperties.Name="{loc:Loc report.invite.decline}">
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE711;" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </Button>
                </Grid>
                <TextBlock x:Name="Body" FontSize="12" LineHeight="17" Margin="0,8,0,0" TextWrapping="Wrap" KeyboardNavigation.TabIndex="1" />
                <TextBlock x:Name="UsernameLine" FontSize="11" LineHeight="15" Margin="0,4,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" KeyboardNavigation.TabIndex="2" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviewButton" Style="{StaticResource LinkButton}" Padding="4,0" Margin="-4,0,8,0" Click="OnPreview" FontSize="12" Height="28"
                            KeyboardNavigation.TabIndex="3" AutomationProperties.Name="{loc:Loc report.invite.preview}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE890;" FontSize="12" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Text="{loc:Loc report.invite.preview}" Margin="5,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <WrapPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="DeclineButton" Height="28" MinWidth="0" Padding="12,0" FontSize="12" Content="{loc:Loc report.invite.decline}" Click="OnDecline"
                                KeyboardNavigation.TabIndex="4" />
                        <Button x:Name="AcceptButton" Style="{DynamicResource AccentButtonStyle}" Height="28" MinWidth="0" Padding="14,0" FontSize="12"
                                Content="{loc:Loc report.invite.accept}" Click="OnAccept"
                                Margin="8,0,0,0" KeyboardNavigation.TabIndex="5" />
                    </WrapPanel>
                </Grid>
            </StackPanel>

            <!-- The answer: one line, held 2.4 s, then the card collapses -->
            <StackPanel x:Name="Done" Orientation="Horizontal" Margin="12,11" Opacity="0" Visibility="Collapsed" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE930;" FontSize="14" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock x:Name="DoneText" Text="{loc:Loc report.invite.done}" FontSize="12" Margin="8,0,0,0" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
