<UserControl x:Class="AgentSpeed.Settings.Cost.CurrencyPicker"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:AgentSpeed.Localization"
             xmlns:cost="clr-namespace:AgentSpeed.Presentation.Cost;assembly=AgentSpeed.Presentation"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- A currency row: check, code, name, symbol. The highlight (↑ / ↓, pointer) is the selection, marked by a
             fill and an accent pill so it never depends on colour alone. -->
        <Style x:Key="CurrencyRow" TargetType="ListBoxItem">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="6,1,6,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
            <EventSetter Event="MouseMove" Handler="OnRowMouseMove" />
            <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowClick" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Background="Transparent">
                            <Border x:Name="Chip" CornerRadius="4" Background="Transparent" />
                            <Border x:Name="Indicator" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <Border x:Name="Focus" CornerRadius="4" BorderThickness="2" Visibility="Collapsed"
                                    BorderBrush="{DynamicResource KeyboardFocusBorderColorBrush}" />
                            <ContentPresenter Margin="10,0,12,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Button x:Name="PickerButton" MinWidth="200" MaxWidth="320" HorizontalContentAlignment="Stretch" Click="OnButtonClick" KeyDown="OnButtonKeyDown"
                AutomationProperties.Name="{Binding CurrencyAccessibleName}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding CurrencyCode}" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="·" Margin="6,0,6,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Grid.Column="2" Text="{Binding CurrencyName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock Grid.Column="3" Style="{StaticResource SymbolIcon}" Text="&#xE70D;" FontSize="10" Margin="14,1,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Button>

        <Popup x:Name="Flyout" PlacementTarget="{Binding ElementName=PickerButton}" Placement="Custom" StaysOpen="False"
               AllowsTransparency="True" PopupAnimation="Fade" DataContext="{Binding Picker}"
               Opened="OnOpened" Closed="OnClosed" KeyDown="OnFlyoutKeyDown">
            <Border Margin="12" Width="320" Height="400" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                    TextElement.FontFamily="{DynamicResource AppFontFamily}"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Contained">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0.2" />
                </Border.Effect>
                <DockPanel>
                    <!-- Search: filters as you type; ↑ / ↓ move the highlight, Return selects, Escape closes. -->
                    <Grid DockPanel.Dock="Top" Margin="8,8,8,8">
                        <TextBox x:Name="SearchBox" Text="{Binding Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="40"
                                 Padding="32,5,32,6" VerticalContentAlignment="Center" PreviewKeyDown="OnSearchKeyDown"
                                 AutomationProperties.Name="{loc:Loc settings.currency.search}" />
                        <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE721;" FontSize="13" HorizontalAlignment="Left" Margin="11,0,0,0"
                                   IsHitTestVisible="False" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="{loc:Loc settings.currency.search}" IsHitTestVisible="False" Margin="33,0,34,1" VerticalAlignment="Center"
                                   FontSize="14" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorTertiaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button Style="{StaticResource SubtleButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                MinWidth="0" Width="26" Height="24" Padding="0" IsTabStop="False" Click="OnClearClick"
                                AutomationProperties.Name="{loc:Loc history.cancel}"
                                Visibility="{Binding HasQuery, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource SymbolIcon}" Text="&#xE711;" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Button>
                    </Grid>
                    <Rectangle DockPanel.Dock="Top" Style="{StaticResource Hairline}" />

                    <Grid>
                        <ListBox x:Name="List" ItemsSource="{Binding Rows}" SelectedItem="{Binding Highlighted, Mode=TwoWay}"
                                 ItemContainerStyle="{StaticResource CurrencyRow}" Background="Transparent" BorderThickness="0" Padding="0,4,0,6"
                                 IsTextSearchEnabled="False" IsSynchronizedWithCurrentItem="False" SelectionMode="Single" KeyboardNavigation.TabNavigation="Once"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False"
                                 VirtualizingPanel.IsVirtualizing="False" KeyDown="OnListKeyDown"
                                 AutomationProperties.Name="{loc:Loc settings.currency}">
                            <ListBox.Style>
                                <Style TargetType="ListBox">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListBox.Style>
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox">
                                    <ScrollViewer x:Name="Scroller" Style="{StaticResource OverlayScrollViewer}" Padding="{TemplateBinding Padding}"
                                                  CanContentScroll="False">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ListBox.Template>
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="GroupItem">
                                            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="16,10,12,4"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type cost:CurrencyPickerRow}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="46" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Style="{StaticResource SymbolIcon}" Text="&#xE73E;" FontSize="12" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                   Visibility="{Binding IsCurrent, Converter={StaticResource Visible}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Code}" FontSize="13" FontWeight="SemiBold"
                                                   Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="{Binding Symbol}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="{loc:Loc settings.currency.noResults}" Style="{StaticResource CaptionText}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24,0,24,24"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                    </Grid>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
