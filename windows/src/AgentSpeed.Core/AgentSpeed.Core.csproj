<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AgentSpeed.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsTrimmable>true</IsTrimmable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pure managed zstd (MIT) for DeepSeek Harness frame streams; no native binaries. -->
    <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AgentSpeed.Core.Tests" />
    <InternalsVisibleTo Include="AgentSpeed.Probe" />
  </ItemGroup>
</Project>
